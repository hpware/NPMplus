{
	"type": "object",
	"description": "Health object",
	"additionalProperties": false,
	"required": [
		"status"
	],
	"properties": {
		"status": {
			"type": "string",
			"description": "Healthy",
			"example": "OK"
		},
		"setup": {
			"type": "boolean",
			"description": "Whether the initial setup has been completed",
			"example": true
		},
		"version": {
			"type": "string",
			"description": "The version string",
			"example": "..."
		},
		"password": {
			"type": "boolean",
			"description": "Whether password login is available",
			"example": true
		},
		"oidc": {
			"type": "boolean",
			"description": "Whether OIDC login is configured",
			"example": true
		},
		"oidc_provider_name": {
			"type": "string",
			"description": "Display name for the configured OIDC provider",
			"example": "Authentik"
		},
		"oidc_auto_create_users": {
			"type": "boolean",
			"description": "Whether OIDC users are provisioned automatically",
			"example": false
		},
		"analytics_retention_days": {
			"type": "integer",
			"description": "How many recent days the embedded analytics API reads from logs",
			"example": 3
		}
	}
}
